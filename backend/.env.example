# Copie este arquivo para ".env" e troque os valores antes de rodar
PORT=3001
NODE_ENV=development

# Em produção, use uma chave aleatória forte com 32+ caracteres
# (você pode gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-uma-chave-secreta-bem-longa-e-aleatoria

# Opcional: se vazio, usa o SQLite local (backend/financas.db).
# Na nuvem (Neon.tech), cole aqui a connection string do PostgreSQL (postgresql://...)
DATABASE_URL=

# Opcional em produção: endereço público oficial do seu site (ex.: https://meu-app.onrender.com)
FRONTEND_URL=

# Opcional: envio de e-mail para "Esqueci minha senha" (grátis no Brevo.com — 300 e-mails/dia)
BREVO_API_KEY=
EMAIL_REMETENTE=
